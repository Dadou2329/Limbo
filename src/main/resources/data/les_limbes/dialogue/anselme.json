            }
          ],
          "suivant": "le_phare_d_anselme_cours"
        },
        {
          "texte": "Le relais du phare est-il relié ?",
          "actions": [
            {
              "type": "decouvrir_lieu",
              "id": "phare_du_dessous"
            }
          ]
        },
        {
          "texte": "Merci."
        }
