{
  "multipart": [
    {
      "apply": {
        "model": "les_limbes:block/barriere_d_aube_poteau"
      }
    },
    {
      "apply": {
        "model": "les_limbes:block/barriere_d_aube_cote",
        "uvlock": true
      },
      "when": {
        "north": "true"
      }
    },
    {
      "apply": {
        "model": "les_limbes:block/barriere_d_aube_cote",
        "uvlock": true,
        "y": 90
      },
      "when": {
        "east": "true"
      }
    },
    {
      "apply": {
        "model": "les_limbes:block/barriere_d_aube_cote",
        "uvlock": true,
        "y": 180
      },
      "when": {
        "south": "true"
      }
    },
    {
      "apply": {
        "model": "les_limbes:block/barriere_d_aube_cote",
        "uvlock": true,
        "y": 270
      },
      "when": {
        "west": "true"
      }
    }
  ]
}
